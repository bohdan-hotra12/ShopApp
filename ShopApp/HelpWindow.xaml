<Window x:Class="ShopApp.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Допомога"
        Height="300" Width="400">

    <Grid>
        <StackPanel Margin="20">

            <TextBlock Text="Як користуватись:"
                       FontSize="16"
                       FontWeight="Bold"/>

            <TextBlock Text="1. Введіть назву товару"
                       Margin="0,10,0,0"/>

            <TextBlock Text="2. Введіть ціну"
                       Margin="0,5,0,0"/>

            <TextBlock Text="3. Натисніть 'Додати'"
                       Margin="0,5,0,0"/>

            <Button Content="Закрити"
                    Width="100"
                    Margin="10"
                    Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>