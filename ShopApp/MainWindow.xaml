<Window x:Class="ShopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Магазин" Height="400" Width="400">    <Grid>
        <StackPanel Margin="20">

            <TextBlock Text="Назва товару"/>
            <TextBox Name="txtName" Height="30" Margin="0,5,0,10"/>

            <TextBlock Text="Ціна"/>
            <TextBox Name="txtPrice" Height="30" Margin="0,5,0,10"/>

            <Button Content="Додати товар" Height="35" Click="AddItem_Click"/>

            <Button Content="Видалити вибране" Height="35" Margin="0,10,0,0" Click="DeleteItem_Click"/>

            <ListBox Name="listBox" Margin="0,10,0,0"/>

        </StackPanel>
    </Grid>
</Window>