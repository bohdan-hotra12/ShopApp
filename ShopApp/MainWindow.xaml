<Window x:Class="ShopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShopApp"
        Height="500" Width="700">

    <DockPanel>

        <!-- Меню -->
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
            <Button Content="Home" Click="Home_Click" Margin="5"/>
            <Button Content="List" Click="List_Click" Margin="5"/>
            <Button Content="Settings" Click="Settings_Click" Margin="5"/>
            <Button Content="Про програму" Click="OpenAbout_Click" Margin="5"/>
            <Button Content="Допомога" Click="OpenHelp_Click" Margin="5"/>
        </StackPanel>
        

        <!-- Frame -->
        <Frame x:Name="MainFrame"/>
    </DockPanel>
</Window>
