<Window x:Class="ShopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ShopApp"
        Height="500" Width="700"
        MinHeight="400" MinWidth="500">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="ShopApp - Склад товарів"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <!-- Панель вводу -->
        <StackPanel Grid.Row="1" Margin="0,0,0,10">

            <Label Content="Назва товару"/>
            <TextBox x:Name="txtName" Height="25" Width="200"/>

            <Label Content="Ціна товару"/>
            <TextBox x:Name="txtPrice" Height="25" Width="200"/>

            <!-- Кнопки -->
            <WrapPanel Margin="0,10,0,0">

                <Button Content="Додати"
                        Click="AddItem_Click"
                        Margin="5"/>

                <Button Content="Видалити"
                        Click="DeleteItem_Click"
                        Margin="5"/>

                <Button Content="Очистити"
                        Click="ClearAll_Click"
                        Margin="5"/>

                <Button Content="Інфо"
                        Click="ShowInfo_Click"
                         Margin="5"/>
                <Button Content="Про програму"
        Click="OpenAbout_Click"
        Margin="5"/>

                <Button Content="Допомога"
        Click="OpenHelp_Click"
        Margin="5"/>


            </WrapPanel>
        </StackPanel>

        <!-- Список -->
        <ListBox x:Name="listBox"
                 Grid.Row="2"
                 Margin="0,10,0,10"/>

        <!-- Статус -->
        <TextBlock x:Name="statusText"
                   Grid.Row="3"
                   Text="Готово"
                   FontStyle="Italic"/>
    </Grid>
</Window>